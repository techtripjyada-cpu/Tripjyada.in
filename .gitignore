# Secret keys — NEVER commit these
.env

# Environment-specific config (base_url differs per environment)
application/config/config.php
admin/config/config.php
application/config/database.php
admin/config/database.php
# Uploads (user-generated; managed on server)
assets/uploads/

# PHP runtime cache (contains refreshed tokens & feed data)
application/cache/*.cache
application/cache/*.json

# PHP error logs
*.log
application/logs/*
!application/logs/index.html

# Runtime/user-generated temporary files
assets/temp/
files/citybanner/

# Dev-only seed/migration scripts
scripts/

# Node (build tooling only, not needed on server)
node_modules/

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
.settings/
