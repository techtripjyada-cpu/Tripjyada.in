# Copy this file to .env for local development. Never commit the real .env.
# Hostinger must use CI_ENV=production.
CI_ENV=development

# Admin access (prefer a password_hash() value over a plaintext password)
TRIPJYADA_ADMIN_PASSWORD_HASH=
TRIPJYADA_ADMIN_PASSWORD=
TRIPJYADA_ADMIN_SESSION_EXPIRY=7200

# Payments and chatbot
RZP_KEY_ID=
RZP_KEY_SECRET=
RZP_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=

# Instagram
INSTAGRAM_ACCESS_TOKEN=

# Google Business Profile
TRIPJYADA_GOOGLE_BUSINESS_ENABLED=false
TRIPJYADA_GOOGLE_CLIENT_ID=
TRIPJYADA_GOOGLE_CLIENT_SECRET=
TRIPJYADA_GOOGLE_REFRESH_TOKEN=
TRIPJYADA_GOOGLE_ACCOUNT_ID=
TRIPJYADA_GOOGLE_LOCATION_ID=
TRIPJYADA_GOOGLE_CACHE_TTL=21600
TRIPJYADA_GOOGLE_MAX_REVIEWS=10

# WhatsApp/SMS OTP
TRIPJYADA_WHATSAPP_PROVIDER=test
TRIPJYADA_MSG91_AUTH_KEY=
TRIPJYADA_MSG91_TEMPLATE_ID=
TRIPJYADA_FAST2SMS_API_KEY=
TRIPJYADA_META_WHATSAPP_TOKEN=
TRIPJYADA_META_WHATSAPP_PHONE_ID=
TRIPJYADA_META_WHATSAPP_TEMPLATE=otp_verification
TRIPJYADA_OTP_LENGTH=6
TRIPJYADA_OTP_EXPIRY=10
TRIPJYADA_OTP_MAX_ATTEMPTS=3
TRIPJYADA_OTP_COOLDOWN=60

# SMTP
TRIPJYADA_SMTP_PROTOCOL=smtp
TRIPJYADA_SMTP_HOST=smtp.gmail.com
TRIPJYADA_SMTP_PORT=587
TRIPJYADA_SMTP_USER=
TRIPJYADA_SMTP_PASS=
TRIPJYADA_SMTP_CRYPTO=tls
TRIPJYADA_SMTP_TIMEOUT=15

# Mail/contact behavior
TRIPJYADA_SUPPORT_EMAIL=info@tripjyada.com
TRIPJYADA_REPLY_TO_EMAIL=
TRIPJYADA_BOOKING_NOTIFICATION_EMAIL=
TRIPJYADA_CONTACT_NOTIFICATION_EMAIL=
TRIPJYADA_FAQ_NOTIFICATION_EMAIL=
TRIPJYADA_NEWSLETTER_NOTIFICATION_EMAIL=
TRIPJYADA_SLIDER_NOTIFICATION_EMAIL=
TRIPJYADA_COMPANY_NAME=Tripjyada
TRIPJYADA_COMPANY_DOMAIN=tripjyada.in
TRIPJYADA_SUPPORT_PHONE=
TRIPJYADA_SUPPORT_PHONE_HTML=
TRIPJYADA_PUBLIC_CONTACT_EMAILS=info@tripjyada.com
TRIPJYADA_MAIL_TEST_TOKEN=
TRIPJYADA_MAIL_TEST_DEFAULT_RECIPIENT=
TRIPJYADA_SEND_BOOKING_AUTO_REPLY=true
TRIPJYADA_SEND_CONTACT_AUTO_REPLY=true
